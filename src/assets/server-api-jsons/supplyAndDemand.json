      "badge_ar": "\u0623\u0648\u0644\u0648\u064a\u0629 \u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629",
      "title": "Narrow the Supply-Demand Gap Through Skills Programs",
      "title_ar": "\u062a\u0636\u064a\u064a\u0642 \u0641\u062c\u0648\u0629 \u0627\u0644\u0639\u0631\u0636 \u0648\u0627\u0644\u0637\u0644\u0628 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0645\u0647\u0627\u0631\u0627\u062a",
      "text": "The labor market shows persistent structural mismatches between supply and demand, particularly in emerging technology and healthcare sectors.",
      "text_ar": "\u064a\u064f\u0638\u0647\u0631 \u0633\u0648\u0642 \u0627\u0644\u0639\u0645\u0644 \u0627\u062e\u062a\u0644\u0627\u0644\u0627\u062a \u0647\u064a\u0643\u0644\u064a\u0629 \u0645\u0633\u062a\u0645\u0631\u0629 \u0628\u064a\u0646 \u0627\u0644\u0639\u0631\u0636 \u0648\u0627\u0644\u0637\u0644\u0628.",
