    "aiRecommendation": {
      "badge": "Growth",
      "badge_ar": "\u0646\u0645\u0648",
      "title": "Employment Numbers Reach Record Highs",
      "title_ar": "\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u062a\u0648\u0638\u064a\u0641 \u062a\u0635\u0644 \u0625\u0644\u0649 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0642\u064a\u0627\u0633\u064a\u0629",
      "text": "Total employment has grown steadily, reaching over 1.3 million in 2025, driven by private sector expansion and government diversification initiatives.",
      "text_ar": "\u0646\u0645\u0627 \u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u0648\u0638\u064a\u0641 \u0628\u0634\u0643\u0644 \u0645\u0637\u0631\u062f\u060c \u0645\u062a\u062c\u0627\u0648\u0632\u0627\u064b 1.3 \u0645\u0644\u064a\u0648\u0646 \u0641\u064a 2025.",
      "reason": "Abu Dhabi's economic diversification strategy has expanded employment beyond traditional oil and gas sectors, with growth concentrated in technology, finance, tourism, and construction.",
