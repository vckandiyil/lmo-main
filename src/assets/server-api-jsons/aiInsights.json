    "aiRecommendation": {
      "badge": "AI Generated",
      "badge_ar": "\u0645\u064f\u0646\u0634\u0623 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a",
